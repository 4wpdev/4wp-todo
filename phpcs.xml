<?xml version="1.0"?>
<ruleset name="4WP Todo">
	<description>PHPCS for 4wp-todo (extends 4wp-dev-toolkit).</description>

	<rule ref="../4wp-dev-toolkit/phpcs.xml.dist"/>

	<file>4wp-todo.php</file>
	<file>includes</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<config name="text_domain" value="4wp-todo"/>
</ruleset>
